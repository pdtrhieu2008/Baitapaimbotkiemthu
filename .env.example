# ===========================================================================
# QuantBot - environment template
#
#   cp .env.example .env      then fill in your own values.
#
# .env is git-ignored. NEVER commit real keys.
# Every ${VAR} placeholder in config/config.yaml is resolved from here (or
# from the real process environment, which wins over the file).
# ===========================================================================

# --- Exchange (Binance by default) -----------------------------------------
# The bot only needs READ permission: it fetches market data and emits
# signals. Do NOT enable withdrawals. Do NOT enable trading unless you have
# deliberately built and reviewed an execution module (not shipped here).
# Leave both empty to run fully public/anonymous: OHLCV, tickers, funding and
# open interest are public endpoints on Binance.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram ---------------------------------------------------------------
# 1. Talk to @BotFather -> /newbot -> copy the token below.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#    result[0].message.chat.id  (negative number for groups).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: news sentiment ----------------------------------------------
# Not required. If empty, the news component is skipped and its scoring
# weight is redistributed instead of being silently counted as 0.
# Compatible providers: newsapi.org, cryptopanic.com (see config.yaml).
NEWS_API_KEY=

# --- Runtime overrides (optional) ------------------------------------------
# Any of these override config/config.yaml at load time.
QUANTBOT_CONFIG=config/config.yaml
QUANTBOT_LOG_LEVEL=INFO
